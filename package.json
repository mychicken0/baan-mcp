{
  "name": "baan-mcp",
  "version": "0.1.0",
  "description": "Self-hosted remote MCP server for your own computer: built-in password login, 4 pi-style tools, everything else is a plugin.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "baan": "./src/cli.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/cli.ts start",
    "setup": "node src/cli.ts setup",
    "passwd": "node src/cli.ts passwd",
    "config": "node src/cli.ts config",
    "check": "node src/cli.ts check",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "plugins/*"
  ]
}
